{
  "name": "cv-cody-zuschlag",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "render": "pnpm build && node lib/index.js",
    "start": "pnpm render",
    "dev": "nodemon --watch src --ext tsx,ts --exec pnpm render",
    "lint": "xo",
    "test": "pnpm build && pnpm --dir site build && node --test tests/*.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm render && pnpm check:pdf && pnpm build:site",
    "check:pdf": "python3 scripts/check-pdfs.py",
    "preview": "python3 scripts/check-pdfs.py --preview",
    "build:site": "pnpm build && pnpm --dir site build && node lib/build-site.js",
    "serve": "python3 -m http.server 4173 --bind 127.0.0.1 --directory output/site",
    "setup": "node scripts/setup.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/types": "^2.14.0",
    "package-directory": "^8.2.0",
    "react": "^19.3.1",
    "react-pdf-tailwind": "^3.0.0"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@12.16.1",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "eslint-config-xo-react": "^0.32.0",
    "nodemon": "^3.1.14",
    "typescript": "~6.0.3",
    "xo": "^5.0.1"
  }
}
